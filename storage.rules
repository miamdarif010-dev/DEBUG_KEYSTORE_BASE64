rules_version = '2';

// BuyNova Firebase Storage rules.
// Only profile pictures use Storage (profile_images/{uid}.jpg).
// Product images go through Cloudinary, not here.
service firebase.storage {
  match /b/{bucket}/o {

    // Profile picture: anyone signed in can see it,
    // only its owner can upload / replace / delete it.
    match /profile_images/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
