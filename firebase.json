{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/r/**",
        "function": {
          "functionId": "sharePage",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/p/**",
        "function": {
          "functionId": "sharePage",
          "region": "asia-northeast3"
        }
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/privacy.html",
        "destination": "/shop/privacy.html",
        "type": 301
      },
      {
        "source": "/terms.html",
        "destination": "/shop/terms.html",
        "type": 301
      },
      {
        "source": "/delete-account.html",
        "destination": "/shop/delete-account.html",
        "type": 301
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
